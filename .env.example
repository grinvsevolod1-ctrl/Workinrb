# WorkInRB Environment Variables

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/workinrb?schema=public"

# JWT Secret (generate a secure random string for production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# Facebook / Meta Pixel
# Server-side (for Conversions API)
FB_PIXEL_ID="your-facebook-pixel-id"
FACEBOOK_ACCESS_TOKEN="your-facebook-conversions-api-access-token"
# Client-side (for Meta Pixel script) - NEXT_PUBLIC_ prefix required for client access
NEXT_PUBLIC_FB_PIXEL_ID="your-facebook-pixel-id"

# Admin credentials for initial setup (used by scripts/create-admin.ts)
ADMIN_EMAIL="admin@workinrb.top"
ADMIN_PASSWORD="your-secure-password"
ADMIN_NAME="Администратор"
